  "components": [
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Buttons carry the action hierarchy: one crimson primary per context, matte-black secondary for strong but non-critical actions, and ghost for everything else."
    },
    {
      "name": "IconButton"
    },
    {
      "name": "Omnibox",
      "group": "Inputs",
      "summary": "The omnibox is the single entry point for search and commands — the browser-shell address bar and the Command Center's central AI/search field share it."
    },
    {
      "name": "Tabs",
      "group": "Inputs",
      "summary": "Section tabs inside a workspace; the selected tab gets a 2px accent-crimson underline and full ink-primary text."
    },
    {
      "name": "Toggle",
      "group": "Inputs",
      "summary": "A native checkbox with role=\"switch\"."
    },
    {
      "name": "Slider",
      "group": "Inputs",
      "summary": "A native range input."
    },
    {
      "name": "Select",
      "group": "Inputs",
      "summary": "A native with a crimson caret."
    },
    {
      "name": "TabStrip",
      "group": "Browser Shell",
      "summary": "The browser tab strip sits on surface-inverse (black architecture)."
    },
    {
      "name": "BookmarksBar",
      "group": "Browser Shell",
      "summary": "32px favorites bar on surface-primary under the omnibox."
    },
    {
      "name": "UtilityRail",
      "group": "Browser Shell",
      "summary": "56px black rail (rail-width) for workspace switching."
    },
    {
      "name": "ToolTile",
      "group": "Command Center",
      "summary": "Quick-launch tiles: white card, radius-8, depth-1, a chamfered black icon plate and a mono module ID."
    },
    {
      "name": "CommandModule",
      "group": "Command Center",
      "summary": "A native / module with a mono crimson ID, a Space Grotesk title and a chevron that turns on open."
    },
    {
      "name": "StatusPanel",
      "group": "Command Center",
      "summary": "A black HUD panel (surface-inverse, chamfer-16) for live telemetry: Space Grotesk tabular numbers, mono labels, 4px meters."
    },
    {
      "name": "Terminal",
      "group": "Technical",
      "summary": "A working console: surface-inverse, JetBrains Mono 13/20, selectable output, a real input line."
    },
    {
      "name": "DiagnosticTable",
      "group": "Technical",
      "summary": "Diagnostic results: surface-sunken header, border-default row rules, numbers right-aligned in mono with tabular figures."
    },
    {
      "name": "AIResponse",
      "group": "Technical",
      "summary": "AI answers sit on a calm white card (radius-12): a mono header naming the model and whether it ran locally, the answer in body type, inline code, linked source…"
    },
    {
      "name": "StatusBadge",
      "group": "Feedback",
      "summary": "Each status has its own shape as well as its own colour: success = circle (status-success), warning = triangle (status-warning), error = diamond (status-error)…"
    },
    {
      "name": "Notification",
      "group": "Feedback",
      "summary": "Toasts: white card, radius-8, depth-2, a 4px tone edge, an icon in the tone colour, a bold title and a secondary line."
    },
    {
      "name": "Progress",
      "group": "Feedback",
      "summary": "A 6px track with a crimson fill."
    },
    {
      "name": "Tooltip",
      "group": "Feedback",
      "summary": "Matte-black tooltip (surface-inverse), 12px text, an optional mono shortcut."
    },
    {
      "name": "PhantomHero",
      "group": "Signature",
      "summary": "The one place Trash Polka runs at full strength."
    },
    {
      "name": "HudRing",
      "group": "Signature",
      "summary": "A HUD ring for one headline reading: an ink outer ring, a dotted border-control scale, a rotating crimson arc that signals live activity, and the value in Spac…"
    },
    {
      "name": "Icon",
      "group": "Actions",
      "summary": "Renders one of the 20 system icons as a single-ink mask so it takes currentColor — black on light surfaces, white or crimson-on-inverse on black."
    }
  ],
